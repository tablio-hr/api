# Copy to .env on each host. Do not put Cloudflare tokens here.

DJANGO_SETTINGS_MODULE=config.settings.production
DJANGO_SECRET_KEY=
DJANGO_DEBUG=False
DJANGO_SECURE_SSL_REDIRECT=True

# Stage WSL: admin-stage.tablio.hr, api-stage.tablio.hr, tablio-django, 127.0.0.1
# Production HEL1: admin.tablio.hr, api.tablio.hr, tablio-django, 127.0.0.1
DJANGO_ALLOWED_HOSTS=api-stage.tablio.hr,admin-stage.tablio.hr,tablio-django,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=https://admin-stage.tablio.hr

TABLIO_ADMIN_HOST=admin-stage.tablio.hr
TABLIO_API_HOST=api-stage.tablio.hr
TABLIO_API_KEY_PREFIX=tablio_pk_test_

# Optional stage-seed admin passwords. If unset, seed_stage_tenants prints one.
# SEED_ADMIN_PASSWORD_SIBENIK_1983=
# SEED_ADMIN_PASSWORD_SUPINA_POLJICA=

DB_HOST=postgis
DB_PORT=5432
DB_NAME=tablio_platform_db
DB_USER=tablio
DB_PASSWORD=

REDIS_URL=redis://infra-redis:6379/4
CELERY_BROKER_URL=redis://infra-redis:6379/4
CELERY_RESULT_BACKEND=redis://infra-redis:6379/4
